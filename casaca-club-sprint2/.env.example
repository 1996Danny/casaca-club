# Copiar a .env en el VPS (cp .env.example .env) y ajustar los valores.

# Dominio que atiende nginx dentro del contenedor
NGINX_HOST=casacaclub.shop

# Puerto del VPS -> puerto 80 del contenedor.
# OJO: a propósito NO es 80 ni 443, para no pisar otras apps que ya estén
# escuchando esos puertos en el VPS. Un reverse proxy (el que ya tengas, o
# el Caddy de docker-compose.proxy.yml) es quien debe escuchar 80/443 y
# redirigir hacia este puerto. Ver DEPLOY.md.
HOST_PORT=8081

# --- API de Mercado Pago (servicio "api") ---

# Access Token del panel de desarrolladores de Mercado Pago:
# https://www.mercadopago.com.ar/developers/panel
# Usar el de PRUEBA (empieza con "TEST-") mientras el checkout siga en
# modo sandbox, como corresponde a un proyecto académico que simula
# compras. NUNCA subir el valor real de esta variable al repositorio:
# sólo vive en el .env del VPS (este archivo es la plantilla).
MP_ACCESS_TOKEN=TEST-00000000-0000-0000-0000-000000000000

# URL pública del sitio (sin / al final). Mercado Pago redirige aquí
# después del pago (back_urls en server/index.js).
SITE_URL=https://casacaclub.shop
