# Copiar este archivo a .env en el VPS (cp .env.example .env) y ajustar los valores.

# Dominio(s) que atiende la app. Mientras no tengas dominio, dejá localhost.
# Cuando lo tengas, por ejemplo:  NGINX_HOST=midominio.com www.midominio.com
NGINX_HOST=localhost

# Puerto público del VPS que apunta al puerto 80 del contenedor
HOST_PORT=80
