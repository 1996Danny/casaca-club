# Copiar este archivo a .env en el VPS (cp .env.example .env) y ajustar los valores.

# Dominio(s) que atiende la app.
NGINX_HOST=casacaclub.shop www.casacaclub.shop

# Puerto publicado SOLO en 127.0.0.1 del VPS (ver docker-compose.yml);
# un reverse proxy (el que ya tengas, o el Caddy de
# docker-compose.proxy.yml) es quien debe escuchar 80/443 y redirigir
# hacia este puerto. Ver DEPLOY.md.
HOST_PORT=8082

# --- API de Mercado Pago (servicio "api") ---

# Access Token del panel de desarrolladores de Mercado Pago:
# https://www.mercadopago.com.ar/developers/panel
# Usar el de la sección "Credenciales de prueba" (empieza con "APP_USR-"
# pero está atado a una cuenta de prueba, no cobra dinero real) mientras
# el checkout siga en modo sandbox. NUNCA subir el valor real de esta
# variable al repositorio: sólo vive en el .env del VPS.
MP_ACCESS_TOKEN=APP_USR-00000000-0000-0000-0000-000000000000

# URL pública del sitio (sin / al final). Mercado Pago redirige aquí
# después del pago (back_urls en server/index.js). Con https:// activa
# el auto-retorno automático; con http (p. ej. local) el comprador
# vuelve con un botón manual.
SITE_URL=https://midominio.com
